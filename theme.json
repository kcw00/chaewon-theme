{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "palette": [
        { "slug": "ink",     "color": "#14161A", "name": "Ink" },
        { "slug": "paper",   "color": "#FBFBF9", "name": "Paper" },
        { "slug": "muted",   "color": "#6B7280", "name": "Muted" },
        { "slug": "rule",    "color": "#E3E3DE", "name": "Rule" },
        { "slug": "signal",  "color": "#2F6F5E", "name": "Signal" },
        { "slug": "surface", "color": "#F2F2EE", "name": "Surface" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Instrument Serif\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Serif",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/InstrumentSerif-Regular.woff2"]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace"
        }
      ],
      "fontSizes": [
        { "slug": "small",   "name": "Small",   "size": "0.8125rem", "fluid": false },
        { "slug": "medium",  "name": "Medium",  "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
        { "slug": "large",   "name": "Large",   "size": "1.5rem",    "fluid": { "min": "1.25rem", "max": "1.5rem" } },
        { "slug": "x-large", "name": "X Large", "size": "2.5rem",    "fluid": { "min": "1.875rem", "max": "2.5rem" } },
        { "slug": "display", "name": "Display", "size": "4.5rem",    "fluid": { "min": "2.75rem", "max": "4.5rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "vh", "%"],
      "spacingSizes": [
        { "slug": "20", "name": "1",  "size": "0.75rem" },
        { "slug": "30", "name": "2",  "size": "1.5rem" },
        { "slug": "40", "name": "3",  "size": "3rem" },
        { "slug": "50", "name": "4",  "size": "6rem" },
        { "slug": "60", "name": "5",  "size": "9rem" }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "spacing": {
      "padding": {
        "left": "var(--wp--preset--spacing--30)",
        "right": "var(--wp--preset--spacing--30)"
      },
      "blockGap": "var(--wp--preset--spacing--30)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.1",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--ink)" },
        "typography": { "textDecoration": "underline" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--signal)" }
        }
      }
    },
    "blocks": {
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--rule)" }
      },
      "core/code": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--mono)" },
        "color": { "background": "var(--wp--preset--color--surface)" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    {
      "name": "page-no-title",
      "title": "Page (no title)",
      "postTypes": ["page"]
    }
  ]
}
