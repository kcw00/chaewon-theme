{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,

    "layout": {
      "contentSize": "720px",
      "wideSize": "1180px"
    },

    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": true,
      "customDuotone": false,
      "palette": [
        { "slug": "ink",     "color": "#14161A", "name": "Ink" },
        { "slug": "paper",   "color": "#FDF6ED", "name": "Paper" },
        { "slug": "muted",   "color": "#6B7280", "name": "Muted" },
        { "slug": "rule",    "color": "#E3E3DE", "name": "Rule" },
        { "slug": "signal",  "color": "#2F6F5E", "name": "Signal" },
        { "slug": "surface", "color": "#F2F2EE", "name": "Surface" }
      ]
    },

    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "\"Instrument Serif\", Georgia, \"Times New Roman\", serif",
          "fontFace": [
            {
              "fontFamily": "Instrument Serif",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/InstrumentSerif-Regular.woff2" ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "400 600",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/Inter-Variable.woff2" ]
            }
          ]
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
          "fontFace": [
            {
              "fontFamily": "JetBrains Mono",
              "fontWeight": "400 500",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/JetBrainsMono-Variable.woff2" ]
            }
          ]
        },
        {
          "slug": "lead",
          "name": "Lead",
          "fontFamily": "\"Cardo\", Georgia, \"Times New Roman\", serif",
          "fontFace": [
            {
              "fontFamily": "Cardo",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/Cardo-Regular.woff2" ]
            },
            {
              "fontFamily": "Cardo",
              "fontWeight": "400",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/Cardo-Italic.woff2" ]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small",    "name": "Small",    "size": "0.8125rem", "fluid": false },
        { "slug": "medium",   "name": "Medium",   "size": "1.0625rem", "fluid": { "min": "1rem",      "max": "1.0625rem" } },
        { "slug": "large",    "name": "Large",    "size": "1.375rem",  "fluid": { "min": "1.1875rem", "max": "1.375rem" } },
        { "slug": "x-large",  "name": "X Large",  "size": "2rem",      "fluid": { "min": "1.5rem",    "max": "2rem" } },
        { "slug": "xx-large", "name": "XX Large", "size": "3.25rem",   "fluid": { "min": "2.125rem",  "max": "3.25rem" } },
        { "slug": "display",  "name": "Display",  "size": "7rem",      "fluid": { "min": "3.25rem",   "max": "7rem" } }
      ]
    },

    "spacing": {
      "units": [ "px", "rem", "em", "vh", "vw", "%" ],
      "spacingSizes": [
        { "slug": "10", "name": "1 — Hair",    "size": "0.5rem" },
        { "slug": "20", "name": "2 — Tight",   "size": "0.75rem" },
        { "slug": "30", "name": "3 — Base",    "size": "1.5rem" },
        { "slug": "40", "name": "4 — Loose",   "size": "3rem" },
        { "slug": "50", "name": "5 — Section", "size": "6rem" },
        { "slug": "60", "name": "6 — Chapter", "size": "9rem" },
        { "slug": "70", "name": "7 — Rest",    "size": "12rem" }
      ]
    },

    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "lift",  "name": "Lift",  "shadow": "0 1px 2px rgba(20, 22, 26, 0.04), 0 8px 24px -12px rgba(20, 22, 26, 0.14)" },
        { "slug": "raise", "name": "Raise", "shadow": "0 2px 4px rgba(20, 22, 26, 0.05), 0 20px 48px -20px rgba(20, 22, 26, 0.22)" }
      ]
    },

    "border": { "color": true, "radius": true, "style": true, "width": true },

    "custom": {
      "radius": {
        "sm":   "10px",
        "md":   "16px",
        "lg":   "24px",
        "pill": "999px"
      },
      "ease": {
        "out":   "cubic-bezier(0.16, 1, 0.3, 1)",
        "inout": "cubic-bezier(0.65, 0, 0.35, 1)"
      },
      "duration": {
        "fast": "180ms",
        "base": "320ms",
        "slow": "700ms"
      },
      "tracking": {
        "label": "0.14em",
        "tight": "-0.02em",
        "snug":  "-0.03em"
      },
      "rail":   { "width": "5.5rem" },
      "header": { "height": "5rem" }
    },

    "useRootPaddingAwareAlignments": true
  },

  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },

    "spacing": {
      "padding": {
        "left": "var(--wp--preset--spacing--30)",
        "right": "var(--wp--preset--spacing--30)"
      },
      "blockGap": "var(--wp--preset--spacing--30)"
    },

    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "fontWeight": "400",
      "lineHeight": "1.65",
      "letterSpacing": "-0.005em"
    },

    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.08",
          "letterSpacing": "var(--wp--custom--tracking--tight)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--display)",
          "lineHeight": "0.95",
          "letterSpacing": "var(--wp--custom--tracking--snug)"
        }
      },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.15" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.25" } },
      "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--small)",
          "letterSpacing": "var(--wp--custom--tracking--label)",
          "textTransform": "uppercase"
        },
        "color": { "text": "var(--wp--preset--color--muted)" }
      },

      "link": {
        "color": { "text": "var(--wp--preset--color--ink)" },
        "typography": { "textDecoration": "none" },
        ":hover": { "color": { "text": "var(--wp--preset--color--signal)" } },
        ":focus": { "color": { "text": "var(--wp--preset--color--signal)" } }
      },

      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--paper)"
        },
        "border": { "radius": "var(--wp--custom--radius--pill)" },
        "spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.75rem", "right": "1.75rem" } },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "500",
          "lineHeight": "1"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--signal)",
            "text": "var(--wp--preset--color--paper)"
          }
        },
        ":focus": {
          "color": {
            "background": "var(--wp--preset--color--signal)",
            "text": "var(--wp--preset--color--paper)"
          }
        }
      },

      "caption": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--small)",
          "letterSpacing": "0.04em"
        },
        "color": { "text": "var(--wp--preset--color--muted)" }
      }
    },

    "blocks": {
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--rule)" }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "color": { "background": "var(--wp--preset--color--surface)" },
        "border": { "radius": "var(--wp--custom--radius--sm)" },
        "spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "1.25rem", "right": "1.25rem" } }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--lead)",
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontStyle": "italic",
          "lineHeight": "1.4"
        },
        "border": {
          "left": {
            "color": "var(--wp--preset--color--signal)",
            "width": "2px",
            "style": "solid"
          }
        },
        "spacing": { "padding": { "left": "var(--wp--preset--spacing--30)" } }
      },
      "core/pullquote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--lead)",
          "fontStyle": "italic"
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "400",
          "letterSpacing": "var(--wp--custom--tracking--tight)"
        }
      },
      "core/post-title": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--display)" }
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--small)",
          "letterSpacing": "0.06em"
        }
      },
      "core/image": {
        "border": { "radius": "var(--wp--custom--radius--md)" }
      }
    }
  },

  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],

  "customTemplates": [
    {
      "name": "page-no-title",
      "title": "Page (no title)",
      "postTypes": [ "page" ]
    }
  ]
}
